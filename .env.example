# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE_CLIENT_ID: Your Google Cloud Console OAuth Client ID
GOOGLE_CLIENT_ID=""

# GOOGLE_CLIENT_SECRET: Your Google Cloud Console OAuth Client Secret
GOOGLE_CLIENT_SECRET=""

# VITE_GOOGLE_CLIENT_ID: Google OAuth Client ID baked into the client bundle
# at build time (read via import.meta.env in src/lib/auth.ts).
VITE_GOOGLE_CLIENT_ID=""

# PORT: HTTP port the server listens on. Container platforms (e.g. Cloud Run)
# inject this automatically; defaults to 3000 for local development.
# PORT="3000"
